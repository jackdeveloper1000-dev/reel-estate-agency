# Copy to client/.env – must match one of the keys in API_KEY in server/.env
# (restart "npm run dev" after changing it)
VITE_API_KEY=

# ---- Google AdSense (rebuild with "npm run build" after changing these) ----
# Publisher ID from AdSense → Account → Settings → Account information, e.g. ca-pub-1234567890123456 (pub-… also works)
# Setting it adds the AdSense code to every page and creates ads.txt – needed before Google can review your site.
VITE_ADSENSE_CLIENT=
# After approval: AdSense → Ads → By ad unit → Display ads → copy the data-ad-slot number (home page ad)
VITE_ADSENSE_SLOT_HOME=
# Optional: separate ad unit for the Guides pages (uses VITE_ADSENSE_SLOT_HOME when empty)
VITE_ADSENSE_SLOT_ARTICLE=
# Email shown on the About and Privacy pages
VITE_CONTACT_EMAIL=
# Your live website address – creates sitemap.xml so Google finds every page, e.g. https://estamotion.in
VITE_SITE_URL=
