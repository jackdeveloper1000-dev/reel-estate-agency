PORT=5005
# MySQL (XAMPP defaults: user root, empty password). The database and tables are created automatically.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=realassets_ai
# Where downloaded photos and rendered videos are stored (relative to /server)
STORAGE_DIR=storage
# Optional: absolute path to your own ffmpeg binary (otherwise ffmpeg-static is used)
FFMPEG_PATH=
# Allowed front-end origin in development
CLIENT_ORIGIN=http://localhost:5180
# Optional: Scraping API URL template with {url} placeholder (used automatically when a portal blocks the server with HTTP 403/429)
# Examples:
#   SCRAPER_API_URL=https://api.scraperapi.com?api_key=YOUR_KEY&country_code=in&url={url}
#   SCRAPER_API_URL=https://api.zenrows.com/v1/?apikey=YOUR_KEY&url={url}
SCRAPER_API_URL=
# Optional: Standard HTTP/HTTPS proxy URL (e.g. http://user:pass@proxy-host:8080)
SCRAPER_PROXY_URL=
# Set to true to always fetch listing pages through the proxy/API instead of only on 403/429 fallback
SCRAPER_ALWAYS_PROXY=false

# ---------- Accounts & login ----------
# Long random string that signs login sessions (required before going live)
APP_SECRET=
# NODE_ENV=production   # turns on secure cookies and turns OFF demo payments

# ---------- SMS / OTP ----------
# console = codes are printed in the server window and shown on screen (testing)
# fast2sms | msg91 | twilio = real SMS. Indian numbers need a DLT-registered sender/template.
SMS_PROVIDER=console
FAST2SMS_API_KEY=
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
# Optional MSG91 template with a ##message## variable, for the "film ready" text
MSG91_NOTIFY_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Text the user when their film has finished rendering
SMS_NOTIFY_FILM_READY=false

# ---------- Payments (Razorpay) ----------
# Dashboard → Account & Settings → API Keys. Use rzp_test_… keys while testing.
# Leave empty for DEMO mode (no real money, only when NODE_ENV is not production).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Price of one film in rupees
PRICE_PER_FILM_INR=499
