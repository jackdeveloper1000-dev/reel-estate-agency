PORT=5000
# MySQL (XAMPP defaults: user root, empty password). The database and tables are created automatically.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=realassets_ai
# Where downloaded photos and rendered videos are stored (relative to /server)
STORAGE_DIR=storage
# Optional: absolute path to your own ffmpeg binary (otherwise ffmpeg-static is used)
FFMPEG_PATH=
# Allowed front-end origin in development
CLIENT_ORIGIN=http://localhost:5173
